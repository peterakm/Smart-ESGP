SMART_ESGP_DEPLOYMENT_ENV=production
SMART_ESGP_ALLOWED_ORIGINS=https://dashboard.smart-esgp.example
SMART_ESGP_TRUST_PROXY=true
SMART_ESGP_FORCE_HTTPS=true
SMART_ESGP_HSTS_MAX_AGE_SECONDS=31536000
SMART_ESGP_ACCESS_LOGS=true
SMART_ESGP_JSON_BODY_LIMIT=256kb
SMART_ESGP_DASHBOARD_JSON_BODY_LIMIT=256kb
SMART_ESGP_WHATSAPP_JSON_BODY_LIMIT=256kb
SMART_ESGP_API_LIST_LIMIT_MAX=100
SMART_ESGP_CHAT_RATE_LIMIT_PER_MINUTE=30
SMART_ESGP_CERTIFICATE_VERIFY_RATE_LIMIT_PER_MINUTE=60
SMART_ESGP_WHATSAPP_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
SMART_ESGP_WHATSAPP_MANUAL_SEND_RATE_LIMIT_PER_MINUTE=60
SMART_ESGP_WHATSAPP_CLAIM_TTL_SECONDS=300
SMART_ESGP_RETAIN_WHATSAPP_RAW_PAYLOADS=false

# Shared PostgreSQL repository for both deployable services.
POSTGRES_DB=smart_esgp
POSTGRES_USER=smart_esgp
POSTGRES_PASSWORD=replace-with-strong-password
SMART_ESGP_REPOSITORY=postgres
DATABASE_URL=postgresql://smart_esgp:replace-with-strong-password@postgres:5432/smart_esgp
SMART_ESGP_POSTGRES_SCHEMA=
# File repository retention limits, used only when SMART_ESGP_REPOSITORY=file.
# SMART_ESGP_FILE_EVIDENCE_RECORD_LIMIT=500
# SMART_ESGP_FILE_WHATSAPP_EVENT_LIMIT=100
# SMART_ESGP_FILE_WHATSAPP_CLAIM_LIMIT=5000
# SMART_ESGP_FILE_AUDIT_EVENT_LIMIT=1000

# Private S3-compatible media storage.
SMART_ESGP_MEDIA_STORAGE=s3
SMART_ESGP_S3_BUCKET=smart-esgp-private-evidence
SMART_ESGP_S3_REGION=ap-southeast-1
SMART_ESGP_S3_ENDPOINT=http://minio:9000
SMART_ESGP_S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password

# FELDA dashboard/API access.
SMART_ESGP_REQUIRE_AUTH=true
SMART_ESGP_VIEWER_TOKEN=replace-with-viewer-token
SMART_ESGP_DEALER_TOKEN=replace-with-dealer-token
SMART_ESGP_AUDITOR_TOKEN=replace-with-auditor-token
SMART_ESGP_DASHBOARD_ENABLE_WHATSAPP_WEBHOOK=false
SMART_ESGP_DASHBOARD_ENABLE_WHATSAPP_MANUAL_SEND=false
SMART_ESGP_OIDC_ISSUER=
SMART_ESGP_OIDC_AUDIENCE=
SMART_ESGP_OIDC_JWKS_URI=
SMART_ESGP_OIDC_ROLE_CLAIM=roles
SMART_ESGP_OIDC_VIEWER_ROLES=smart-esgp.viewer,smart-esgp.dealer,smart-esgp.auditor
SMART_ESGP_OIDC_DEALER_ROLES=smart-esgp.dealer,smart-esgp.auditor
SMART_ESGP_OIDC_AUDITOR_ROLES=smart-esgp.auditor

# Meta WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
# Numeric Meta phone-number ID from WhatsApp Manager, not the display phone number.
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Optional live AI support for dashboard chat.
ANTHROPIC_API_KEY=
