    "smoke:whatsapp-delivery-status": "tsx scripts/smoke-whatsapp-delivery-status.ts",
    "smoke:whatsapp-monitoring-filters": "tsx scripts/smoke-whatsapp-monitoring-filters.ts",
    "smoke:whatsapp-raw-payload-retention": "tsx scripts/smoke-whatsapp-raw-payload-retention.ts",
    "smoke:whatsapp-activity": "tsx scripts/smoke-whatsapp-activity-classification.ts",
    "smoke:whatsapp-service": "node scripts/smoke-whatsapp-service.mjs",
    "smoke:whatsapp": "node scripts/smoke-whatsapp-outbound.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@govtechmy/myds-react": "^1.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.17.0"
  }
}
