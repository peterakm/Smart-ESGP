    "smoke:consent": "node scripts/smoke-consent-records.mjs",
    "smoke:deployment-config": "node scripts/validate-deployment-config.mjs",
    "smoke:dashboard-feedback": "tsx scripts/smoke-dashboard-feedback.ts",
    "smoke:ui-render": "tsx scripts/smoke-ui-render.tsx",
    "smoke:evidence-correction": "node scripts/smoke-evidence-correction.mjs",
    "smoke:evidence-review": "node scripts/smoke-evidence-review.mjs",
    "smoke:file-retention": "tsx scripts/smoke-file-repository-retention.ts",
    "smoke:graceful-shutdown": "node scripts/smoke-graceful-shutdown.mjs",
    "smoke:farmer-feedback": "node scripts/smoke-farmer-feedback.mjs",
    "smoke:farmer-review-notifications": "node scripts/smoke-farmer-review-notifications.mjs",
    "smoke:geofence": "tsx scripts/smoke-geofence.ts",
    "smoke:local-only-auth": "node scripts/smoke-local-only-auth.mjs",
