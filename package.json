    "smoke:readiness": "node scripts/smoke-readiness.mjs",
    "smoke:repository-mode": "tsx scripts/smoke-repository-mode.mjs",
    "smoke:rate-limits": "node scripts/smoke-rate-limits.mjs",
    "smoke:security-baseline": "node scripts/smoke-security-baseline.mjs",
    "smoke:security-hardening": "node scripts/smoke-security-hardening.mjs",
    "smoke:service-boundaries": "node scripts/smoke-service-boundaries.mjs",
    "smoke:system-audit-alerts": "tsx scripts/smoke-system-audit-alerts.ts",
    "smoke:whatsapp-idempotency": "node scripts/smoke-whatsapp-idempotency.mjs",
    "smoke:whatsapp-claim-lease": "tsx scripts/smoke-whatsapp-claim-lease.ts",
    "smoke:whatsapp-claim-summary": "tsx scripts/smoke-whatsapp-claim-summary.ts",
    "smoke:whatsapp-identity-conflicts": "tsx scripts/smoke-whatsapp-identity-conflicts.ts",
