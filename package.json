{
  "name": "smart-esgp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:whatsapp": "tsx whatsapp-server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs && esbuild whatsapp-server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/whatsapp-server.mjs",
    "db:migrate": "node scripts/run-postgres-migrations.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "start:whatsapp": "NODE_ENV=production node dist/whatsapp-server.mjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const target of ['dist','server.js']) fs.rmSync(target,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "auth:create-user": "node scripts/create-api-user.mjs",
    "smoke:audit": "node scripts/smoke-audit-events.mjs",
    "smoke:api-errors": "node scripts/smoke-api-error-handling.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:certificates": "node scripts/smoke-certificates.mjs",
