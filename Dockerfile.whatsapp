FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV WHATSAPP_PORT=3100
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY db ./db
COPY scripts/run-postgres-migrations.mjs ./scripts/run-postgres-migrations.mjs

EXPOSE 3100
CMD ["node", "dist/whatsapp-server.mjs"]
