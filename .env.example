# APP_URL: Public base URL for webhook and certificate links.
APP_URL=http://localhost:3000

# SMART_ESGP_DEPLOYMENT_ENV: Set to production to enforce production readiness checks.
SMART_ESGP_DEPLOYMENT_ENV=development

# SMART_ESGP_ALLOWED_ORIGINS: Optional comma-separated exact browser origins for CORS.
# Leave empty for same-origin/private-network dashboard access only.
SMART_ESGP_ALLOWED_ORIGINS=

# SMART_ESGP_TRUST_PROXY: Set true when running behind a trusted reverse proxy/load balancer.
SMART_ESGP_TRUST_PROXY=false

# SMART_ESGP_FORCE_HTTPS: Redirect HTTP requests to HTTPS outside localhost.
SMART_ESGP_FORCE_HTTPS=false

# SMART_ESGP_HSTS_MAX_AGE_SECONDS: Strict-Transport-Security max-age when HTTPS is active.
SMART_ESGP_HSTS_MAX_AGE_SECONDS=15552000

# SMART_ESGP_ACCESS_LOGS: Optional JSON request logs with request IDs.
SMART_ESGP_ACCESS_LOGS=false

# JSON request body limits. Service-specific values override the shared default.
SMART_ESGP_JSON_BODY_LIMIT=256kb
SMART_ESGP_DASHBOARD_JSON_BODY_LIMIT=
SMART_ESGP_WHATSAPP_JSON_BODY_LIMIT=

# Maximum applied limit for dashboard list/read APIs.
SMART_ESGP_API_LIST_LIMIT_MAX=100

# Public/high-risk route rate limits per source IP, per minute.
SMART_ESGP_CHAT_RATE_LIMIT_PER_MINUTE=30
SMART_ESGP_CERTIFICATE_VERIFY_RATE_LIMIT_PER_MINUTE=60
SMART_ESGP_WHATSAPP_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
SMART_ESGP_WHATSAPP_MANUAL_SEND_RATE_LIMIT_PER_MINUTE=60

# ANTHROPIC_API_KEY: Optional key for live AI chat responses.
# If omitted, /api/chat falls back to a local Ollama server (see below), then
# to deterministic simulation mode if Ollama isn't reachable either.
ANTHROPIC_API_KEY=

# OLLAMA_BASE_URL / OLLAMA_MODEL: local Ollama server used as a free fallback
# for /api/chat when ANTHROPIC_API_KEY is not set. Install Ollama and pull a
# model (e.g. `ollama pull llama3.1:8b`). OLLAMA_BASE_URL defaults to
# http://localhost:11434 if omitted, but OLLAMA_MODEL has no default and must
# be set to the model name you pulled, or /api/chat falls back to simulation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# WHATSAPP_VERIFY_TOKEN: Secret token used by Meta to verify the webhook endpoint.
WHATSAPP_VERIFY_TOKEN=change-me-in-production

# WHATSAPP_ACCESS_TOKEN: WhatsApp Business Platform permanent or system-user access token.
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID: Meta phone number ID used for sending WhatsApp replies.
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_GRAPH_API_VERSION: Meta Graph API version for outbound message sends.
WHATSAPP_GRAPH_API_VERSION=v23.0

# WHATSAPP_PORT: Optional port for the standalone WhatsApp chatbot service.
WHATSAPP_PORT=3100

# Dashboard WhatsApp demo route switches.
# Local `npm run dev` mounts webhook/manual send routes by default for convenience.
# Production `npm run start` keeps them off unless these are explicitly true.
SMART_ESGP_DASHBOARD_ENABLE_WHATSAPP_WEBHOOK=false
SMART_ESGP_DASHBOARD_ENABLE_WHATSAPP_MANUAL_SEND=false

# SMART_ESGP_DATA_FILE: Local development persistence file for file repository mode.
SMART_ESGP_DATA_FILE=.smart-esgp-data/dev-store.json

# DATABASE_URL / SMART_ESGP_REPOSITORY: Production PostgreSQL repository settings.
DATABASE_URL=
SMART_ESGP_REPOSITORY=file
SMART_ESGP_POSTGRES_SSL=false
SMART_ESGP_POSTGRES_SCHEMA=

# SMART_ESGP_MEDIA_STORAGE: local-filesystem for development, s3 for production.
SMART_ESGP_MEDIA_STORAGE=local-filesystem
SMART_ESGP_MEDIA_DIR=.smart-esgp-media
SMART_ESGP_S3_BUCKET=
SMART_ESGP_S3_REGION=ap-southeast-1
SMART_ESGP_S3_ENDPOINT=
SMART_ESGP_S3_FORCE_PATH_STYLE=false

# SMART_ESGP_REQUIRE_AUTH: Set to true to require role tokens on protected APIs.
# If any role token is configured, auth is required automatically.
SMART_ESGP_REQUIRE_AUTH=false

# SMART_ESGP_*_TOKEN: Bearer tokens for FELDA dashboard/API roles.
# viewer can read dashboard data, dealer can use viewer-level APIs for now,
# auditor can perform protected write/update actions.
SMART_ESGP_VIEWER_TOKEN=
SMART_ESGP_DEALER_TOKEN=
SMART_ESGP_AUDITOR_TOKEN=

# SMART_ESGP_OIDC_*: Optional FELDA SSO / identity-provider JWT validation.
# When issuer, audience, and JWKS URI are set, bearer JWTs are validated through OIDC/JWKS.
SMART_ESGP_OIDC_ISSUER=
SMART_ESGP_OIDC_AUDIENCE=
SMART_ESGP_OIDC_JWKS_URI=
SMART_ESGP_OIDC_ROLE_CLAIM=roles
SMART_ESGP_OIDC_VIEWER_ROLES=smart-esgp.viewer,smart-esgp.dealer,smart-esgp.auditor
SMART_ESGP_OIDC_DEALER_ROLES=smart-esgp.dealer,smart-esgp.auditor
SMART_ESGP_OIDC_AUDITOR_ROLES=smart-esgp.auditor

# WHATSAPP_APP_SECRET: Optional Meta app secret for X-Hub-Signature-256 validation.
# Configure this for real WhatsApp webhook deployments.
WHATSAPP_APP_SECRET=
